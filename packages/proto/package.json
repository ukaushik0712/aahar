	"type": "module",
	"scripts": {
		"generate": "yarn buf generate"
	},
	"exports": {
		"./auth/v1": {
			"types": "./src/gen/aahar/auth/v1/auth_pb.d.ts",
			"default": "./src/gen/aahar/auth/v1/auth_pb.js"
		},
		"./catalog/v1": {
			"types": "./src/gen/aahar/catalog/v1/catalog_pb.d.ts",
			"default": "./src/gen/aahar/catalog/v1/catalog_pb.js"
		},
		"./cart/v1": {
			"types": "./src/gen/aahar/cart/v1/cart_pb.d.ts",
