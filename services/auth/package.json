{
	"name": "@aahar/auth",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build": "yarn tsdown",
		"start": "node --env-file=./src/.env.development ./dist/server.js",
		"dev": "dotenv -e ./src/.env.development -- tsx watch ./src/server.ts",
		"db:migrate": "dotenv -e ./src/.env.development -- tsx src/db/migrator.ts",
		"db:rollback": "dotenv -e ./src/.env.development -- tsx src/db/migrator.ts --down"
	},
	"dependencies": {
		"@aahar/logger": "workspace:^",
		"@aahar/proto": "workspace:^",
		"@aahar/util": "workspace:^",
		"@connectrpc/connect": "^2.2.0",
		"@connectrpc/connect-node": "^2.2.0",
		"@connectrpc/validate": "^0.2.0",
		"ioredis": "^6.0.0",
		"jose": "^6.2.12",
		"kysely": "^0.29.6",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@aahar/tsconfig": "workspace:^",
		"@types/pg": "^8",
		"dotenv-cli": "^11.0.0",
		"tsdown": "^0.23.1",
		"tsx": "^4.23.15"
	}
}
